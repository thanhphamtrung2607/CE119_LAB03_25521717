.data
n_val:  .word 20         #thay doi gia tri n o day
msg:    .asciiz "F(n) = "

.text
.globl main

# Thu tuc : main
# Mieu ta : Doc n tu n_val, goi fib_rec (hoac doi thanh fib_iter khi do),
#           in "F(n) = <gia tri>" va thoat bang syscall 10
main:
        lw    $a0, n_val        #doc n tu bo nho .data
        jal   fib_rec           #doi thanh: jal fib_iter de doi thu tuc lap
        move  $s0, $v0          #luu F(n) vao $s0
        li    $v0, 4
        la    $a0, msg
        syscall
        move  $a0, $s0
        li    $v0, 1
        syscall
        li    $v0, 10
        syscall
# fib_iter: tinh F(n) bang vong lap
# Tham so : $a0 = n    Tra ve : $v0 = F(n)
# Thanh ghi: $t0-$t3 (thu tuc la)
fib_iter:
        move  $v0, $zero        # a = F(0)
        li    $t0, 1            # b = F(1)
        move  $t1, $zero        # i = 0
fi_loop:
        slt   $t2, $t1, $a0
        beq   $t2, $zero, fi_done
        addu  $t3, $v0, $t0     # a + b
        move  $v0, $t0
        move  $t0, $t3
        addiu $t1, $t1, 1
        j     fi_loop
fi_done:
        jr    $ra
        
fib_rec:
       addi $sp, $sp ,-12   # cap khung ngan xep 3 word( 12 bytes) 
       sw $ra, 8($sp)       # cat dia chi tro ve $ra
       sw $s0, 4($sp)       # cat $s0( giu tham so n)
       sw $s1, 0($sp)       # cat $s1 ( giu ket qua F(n-1) )
       
       slti $t0, $a0, 2     # check truong hop co so n < 2
       beq $t0, $zero, fr_rec  
       move $v0, $a0        # neu n < 2: F(n) = n
       j fr_done
fr_rec: 
       move $s0, $a0        # $s0 = n
       addi $a0, $s0, -1    # $a0 = n - 1
       jal fib_rec          # $v0 = F(n-1)
       move $s1, $v0        #$s1 = F(n-1)
       addi $a0, $s0, -2    # $a0 = n - 2
       jal fib_rec
       add $v0 , $s1, $v0   #$v0 = F(n-1) + F(n-2)
fr_done: 
       lw $s1, 0($sp)
       lw $s0, 4($sp)
       lw $ra, 8($sp)
       addi $sp, $sp, 12
       jr $ra  
       
